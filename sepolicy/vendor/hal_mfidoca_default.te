type hal_mfidoca_default, domain;
type hal_mfidoca_default_exec, exec_type, file_type, vendor_file_type;
type hal_mfidoca_service, hal_service_type, service_manager_type;

init_daemon_domain(hal_mfidoca_default)
binder_use(hal_mfidoca_default)

allow hal_mfidoca_default hal_mfidoca_service:service_manager { add find };
allow hal_mfidoca_default tee_device:chr_file rw_file_perms;
allow hal_mfidoca_default vendor_dmabuf_qseecom_ta_heap_device:chr_file rw_file_perms;
allow hal_mfidoca_default vendor_miev_device:chr_file rw_file_perms;