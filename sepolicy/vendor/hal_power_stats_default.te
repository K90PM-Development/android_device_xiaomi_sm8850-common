type vendor_sysfs_powerstats, fs_type, sysfs_type;

allow hal_power_stats_default sysfs:dir r_dir_perms;
allow hal_power_stats_default vendor_sysfs_powerstats:dir search;
allow hal_power_stats_default vendor_sysfs_powerstats:file { getattr open read ioctl lock map watch watch_reads open append write lock map };